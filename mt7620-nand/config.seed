# ImmortalWrt build seed for ramips/mt7620_nand (ImageBuilder-first subtarget build)
# Expand with: cp mt7620-nand/config.seed .config && make defconfig
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620_nand=y
# Multi-profile with no device selected builds no per-device .bin images during
# make world, while still building kernels/DTBs for every device in
# target/linux/ramips/image/mt7620_nand.mk when CONFIG_IB=y.
CONFIG_TARGET_MULTI_PROFILE=y
# Build every kernel module (implies CONFIG_ALL_KMODS=y) and every
# target-specific package (base-files, uboot-envtools, mtd, toolchain libs,
# etc.) so the ImageBuilder has full local coverage for this exact kernel
# vermagic.
CONFIG_ALL_NONSHARED=y
# Produce a standalone ImageBuilder: bundles all local kernel/kmod/target
# packages and lists ImmortalWrt's remote mipsel_24kc userland feeds via our
# target/imagebuilder/Makefile patch.
CONFIG_IB=y
CONFIG_IB_STANDALONE=y
# Per-package build logs under logs/ — CI uploads them when a build fails
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
# The 25.12 release repo publishes no video feed; =m keeps its URL commented
# out in the ImageBuilder/router feed lists instead of 404ing on every update
CONFIG_FEED_video=m
